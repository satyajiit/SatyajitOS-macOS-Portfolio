# Copy to .env.local and fill in what you need. Everything here is optional.

# Sub-path the app is served from. "/" for a custom domain,
# "/<repo-name>/" for GitHub Pages project sites (the deploy workflow sets this for you).
VITE_BASE=/

# Absolute URL of the deployed site, used for canonical + Open Graph tags.
VITE_SITE_URL=https://satyajiit.github.io/SatyajitOS-macOS-Portfolio

# Firebase Analytics (optional). Leave blank and analytics is a no-op —
# the Firebase SDK is never even downloaded.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
